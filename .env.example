# Copy to .env and fill in for your environment.

# Which database the app, the Prisma CLI and the seed script talk to: dev | prod
# Defaults to dev when unset, so a missing value can never mean production.
APP_ENV="dev"

# MySQL connections. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode reserved characters in the password (# is %23, @ is %40).
# Laragon/XAMPP default is a passwordless root: mysql://root@127.0.0.1:3306/onegp_fleet
DATABASE_URL_DEV="mysql://root:password@127.0.0.1:3306/onegp_fleet"
DATABASE_URL_PROD="mysql://user:password@host:3306/onegp_fleet"

# Signing secret for the session cookie. Use a long random value in production.
SESSION_SECRET="change-me"
